VITE_GA_MEASUREMENT_ID=G-XXXXXXXXXX

# Supabase (Phase 2)
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# API base URL (Phase 2)
VITE_API_BASE_URL=http://localhost:8787

# --- Server-side (apps/api) ---
# Stripe — use test keys locally; live keys only on Render after §6.3 cutover
# Test: sk_test_... / whsec_... (test webhook) / price_... (test price)
# Live: sk_live_... / whsec_... (live webhook) / price_... (live price)
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_PRICE_ID=price_...
WEB_ORIGIN=http://localhost:5173

# Supabase service role (server only)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Optional API tuning
# NODE_ENV=production           # in prod, host injects env and WEB_ORIGIN becomes required (CORS lock-down)
# RATE_LIMIT_MAX=100            # per-IP requests/min (abuse prevention); checkout is tightened to 10/min
